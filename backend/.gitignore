# ====================================================================
# SECURE DIGITAL DOCUMENT MANAGEMENT SYSTEM - FUTURE-PROOF .GITIGNORE
# ====================================================================

# --------------------------------------------------------------------
# Compiled Java / Build Artifacts
# --------------------------------------------------------------------
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven build directory
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.next
pom.xml.versionsBackup
pom.xml.urbackup
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.db
.mvn/wrapper-hoverfly

# Avoid ignoring the Maven Wrapper itself as it is often needed for CI/CD
!**/mvnw
!**/.mvn/wrapper/maven-wrapper.jar
!**/.mvn/wrapper/maven-wrapper.properties

# --------------------------------------------------------------------
# IntelliJ IDEA (including .idea folder)
